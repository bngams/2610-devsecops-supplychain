      "seed": 1379866629,
      "version": 791,
      "versionNonce": 1097702405,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793194260312,
      "created": 1793194087355,
      "link": null,
      "locked": false,
      "text": "Config: \n- une possibilité => autoriser les sorties \"error\" sur le job, pour éviter de faire le planter le pipeline\n- générer un résultat en json ou autre => générer un rapport html (a partir du json et outils \"annexes\")\n- on peut imaginer des stratégies plus complexes (notifs, job pour envoyer le rapport sur != canaux : mails,\netc..)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Config: \n- une possibilité => autoriser les sorties \"error\" sur le job, pour éviter de faire le planter le pipeline\n- générer un résultat en json ou autre => générer un rapport html (a partir du json et outils \"annexes\")\n- on peut imaginer des stratégies plus complexes (notifs, job pour envoyer le rapport sur != canaux : mails, etc..)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
