    {
      "id": "MaXU9DB8of14s8F5QN8Pp",
      "type": "text",
      "x": 13062.621101080033,
      "y": 108541.41768234677,
      "width": 1062.5878379493665,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
