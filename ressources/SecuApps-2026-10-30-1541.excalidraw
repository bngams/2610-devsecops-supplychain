      "isDeleted": false,
      "boundElements": null,
      "updated": 1793348173545,
      "created": 1793283353456,
      "link": null,
      "locked": false,
      "text": "Exemples de projets OpenSSF pour la sécurité de la Supply Chain :\n- Sigstore => signatures de nos artefacts (cosign, etc...)\n- OpenSLSA => \"framework\" / \"guidelines\" pour sécuriser la supply chain et intégrer\ndes outils de signature / vérification de provenance",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exemples de projets OpenSSF pour la sécurité de la Supply Chain :\n- Sigstore => signatures de nos artefacts (cosign, etc...)\n- OpenSLSA => \"framework\" / \"guidelines\" pour sécuriser la supply chain et intégrer des outils de signature / vérification de provenance",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
